{
  "corpus_version": 1,
  "suite": "link_read",
  "description": "link.get / link.preview / link.stats: slug and id lookups, the one-of selector errors, soft-delete visibility, the preview status matrix and the two stats result shapes.",
  "cases": [
    {
      "name": "link_get_by_slug",
      "doc": "get by slug returns the full LinkView shape (serializer parity oracle)",
      "command": "link.get",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/read", "slug": "read-me" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/read", "slug": "read-me" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "read-me" }, "match": "subset" }
        },
        {
          "label": "get",
          "request": {
            "v": 1,
            "id": "get-slug-1",
            "command": "link.get",
            "args": { "slug": "read-me" }
          },
          "rest_resource": { "method": "GET", "path": "/api/v1/links/read-me", "status": 200 },
          "expect": {
            "ok": true,
            "result": {
              "id": "<id>",
              "slug": "read-me",
              "url": "https://example.com/read",
              "short_url": "<regex:.*/read-me>",
              "created_at": "<ts>",
              "updated_at": "<ts>",
              "status": "active",
              "redirect_type": "temporary",
              "tags": [],
              "metadata": {},
              "campaign": null,
              "stats": {
                "total_redirects": 0,
                "redirects_24h": 0,
                "redirects_7d": 0,
                "last_accessed_at": null
              }
            },
            "match": "exact"
          }
        }
      ]
    },
    {
      "name": "link_get_by_id",
      "doc": "get by opaque id returns the same link captured at create time",
      "command": "link.get",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/byid", "slug": "by-id-page" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/byid", "slug": "by-id-page" },
            "status": 201
          },
          "save": { "id": "$.result.id" },
          "expect": { "ok": true, "result": { "slug": "by-id-page" }, "match": "subset" }
        },
        {
          "label": "get",
          "request": {
            "v": 1,
            "command": "link.get",
            "args": { "id": "${id}" }
          },
          "rest_resource": { "method": "GET", "path": "/api/v1/links/id/${id}", "status": 200 },
          "expect": {
            "ok": true,
            "result": { "id": "${id}", "slug": "by-id-page", "url": "https://example.com/byid", "status": "active" },
            "match": "subset"
          }
        }
      ]
    },
    {
      "name": "link_get_both_slug_and_id",
      "doc": "supplying both slug and id violates the one-of selector",
      "command": "link.get",
      "steps": [
        {
          "label": "get",
          "request": {
            "v": 1,
            "command": "link.get",
            "args": { "slug": "read-me", "id": "abc123" }
          },
          "expect": { "ok": false, "error": { "code": "invalid_field" } }
        }
      ]
    },
    {
      "name": "link_get_neither",
      "doc": "supplying neither slug nor id violates the one-of selector",
      "command": "link.get",
      "steps": [
        {
          "label": "get",
          "request": {
            "v": 1,
            "command": "link.get",
            "args": {}
          },
          "expect": { "ok": false, "error": { "code": "invalid_field" } }
        }
      ]
    },
    {
      "name": "link_get_not_found",
      "doc": "an unknown slug is not_found",
      "command": "link.get",
      "steps": [
        {
          "label": "get",
          "request": {
            "v": 1,
            "command": "link.get",
            "args": { "slug": "ghost-page" }
          },
          "rest_resource": { "method": "GET", "path": "/api/v1/links/ghost-page", "status": 404 },
          "expect": { "ok": false, "error": { "code": "not_found" } }
        }
      ]
    },
    {
      "name": "link_get_deleted_visible_to_management",
      "doc": "a soft-deleted link is still returned by link.get with status deleted (management visibility)",
      "command": "link.get",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/gone", "slug": "soft-gone" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/gone", "slug": "soft-gone" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "soft-gone" }, "match": "subset" }
        },
        {
          "label": "delete",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "soft-gone" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/soft-gone", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "soft-gone", "status": "deleted" }, "match": "subset" }
        },
        {
          "label": "get",
          "request": {
            "v": 1,
            "command": "link.get",
            "args": { "slug": "soft-gone" }
          },
          "rest_resource": { "method": "GET", "path": "/api/v1/links/soft-gone", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "soft-gone", "status": "deleted" }, "match": "subset" }
        }
      ]
    },
