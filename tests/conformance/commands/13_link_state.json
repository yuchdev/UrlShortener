        }
      ]
    },
    {
      "name": "link_restore_after_delete",
      "doc": "restoring a soft-deleted link clears deleted_at so the link resolves active again",
      "command": "link.restore",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/d5", "slug": "state-restore" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/d5", "slug": "state-restore" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "state-restore" }, "match": "subset" }
        },
        {
          "label": "delete",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "state-restore" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/state-restore", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "state-restore", "status": "deleted" }, "match": "subset" }
        },
        {
          "label": "restore",
          "request": {
            "v": 1,
            "command": "link.restore",
            "args": { "slug": "state-restore" }
          },
          "rest_resource": { "method": "POST", "path": "/api/v1/links/state-restore/restore", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "state-restore", "status": "active" }, "match": "subset" }
        }
      ]
    },
    {
      "name": "link_restore_not_deleted",
      "doc": "restoring a link that was never deleted is a no-op that keeps status active (current behavior)",
      "command": "link.restore",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/d6", "slug": "restore-active" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/d6", "slug": "restore-active" },
            "status": 201
