          },
          "expect": { "ok": true, "result": { "slug": "state-enable" }, "match": "subset" }
        },
        {
          "label": "disable",
          "request": {
            "v": 1,
            "command": "link.disable",
            "args": { "slug": "state-enable" }
          },
          "rest_resource": { "method": "POST", "path": "/api/v1/links/state-enable/disable", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "state-enable", "status": "disabled" }, "match": "subset" }
