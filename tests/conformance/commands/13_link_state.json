    },
    {
      "name": "link_state_lifecycle_matrix",
      "doc": "the full create -> disable -> delete -> restore -> enable transition, asserting the resolved status at each step",
      "command": "link.disable",
      "steps": [
        {
          "label": "create",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/d7", "slug": "lifecycle" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/d7", "slug": "lifecycle" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "lifecycle", "status": "active" }, "match": "subset" }
        },
        {
          "label": "disable",
          "request": {
            "v": 1,
            "command": "link.disable",
            "args": { "slug": "lifecycle" }
          },
          "rest_resource": { "method": "POST", "path": "/api/v1/links/lifecycle/disable", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "lifecycle", "status": "disabled" }, "match": "subset" }
        },
        {
          "label": "delete",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "lifecycle" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/lifecycle", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "lifecycle", "status": "deleted" }, "match": "subset" }
        },
        {
          "label": "restore",
          "request": {
            "v": 1,
            "command": "link.restore",
            "args": { "slug": "lifecycle" }
          },
          "rest_resource": { "method": "POST", "path": "/api/v1/links/lifecycle/restore", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "lifecycle", "status": "disabled" }, "match": "subset" }
        },
        {
          "label": "enable",
          "request": {
            "v": 1,
            "command": "link.enable",
            "args": { "slug": "lifecycle" }
          },
          "rest_resource": { "method": "POST", "path": "/api/v1/links/lifecycle/enable", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "lifecycle", "status": "active" }, "match": "subset" }
        }
      ]
    },
    {
      "name": "link_enable_missing_slug",
      "doc": "enable with the required slug argument absent is rejected invalid_field",
      "command": "link.enable",
      "steps": [
        {
          "label": "enable",
          "request": {
            "v": 1,
            "command": "link.enable",
            "args": {}
          },
          "expect": { "ok": false, "error": { "code": "invalid_field" } }
        }
      ]
    },
    {
      "name": "link_delete_blank_slug",
      "doc": "a blank slug is present but resolves to no link, so delete returns not_found (the argument layer does not reject empty strings)",
      "command": "link.delete",
      "steps": [
        {
          "label": "delete",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "" }
          },
          "expect": { "ok": false, "error": { "code": "not_found" } }
        }
      ]
    },
    {
      "name": "link_delete_user_not_authorized",
