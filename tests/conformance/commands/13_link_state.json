          "expect": { "ok": true, "result": { "slug": "state-enable", "status": "active" }, "match": "subset" }
        }
      ]
    },
    {
      "name": "link_enable_not_found",
      "doc": "enabling an unknown slug is not_found",
      "command": "link.enable",
      "steps": [
        {
          "label": "enable",
          "request": {
            "v": 1,
            "command": "link.enable",
