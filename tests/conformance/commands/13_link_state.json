{
  "corpus_version": 1,
  "suite": "link_state",
  "description": "link.delete / enable / disable / restore lifecycle transitions, their not_found and selector errors, the full lifecycle matrix, and the user authorization gate on every mutating state command.",
  "cases": [
    {
      "name": "link_delete_soft",
      "doc": "delete soft-deletes the link; the returned view and a follow-up get both report status deleted",
      "command": "link.delete",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/d1", "slug": "del-soft" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/d1", "slug": "del-soft" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "del-soft", "status": "active" }, "match": "subset" }
        },
        {
          "label": "delete",
          "request": {
            "v": 1,
            "id": "del-1",
            "command": "link.delete",
            "args": { "slug": "del-soft" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/del-soft", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "del-soft", "status": "deleted" }, "match": "subset" }
        },
        {
          "label": "get",
          "request": {
            "v": 1,
            "command": "link.get",
            "args": { "slug": "del-soft" }
          },
          "expect": { "ok": true, "result": { "slug": "del-soft", "status": "deleted" }, "match": "subset" }
        }
      ]
    },
    {
      "name": "link_delete_not_found",
      "doc": "deleting an unknown slug is not_found",
      "command": "link.delete",
      "steps": [
        {
          "label": "delete",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "del-ghost" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/del-ghost", "status": 404 },
          "expect": { "ok": false, "error": { "code": "not_found" } }
        }
      ]
    },
    {
      "name": "link_delete_twice",
      "doc": "deleting an already-deleted link succeeds idempotently and keeps status deleted",
      "command": "link.delete",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/d2", "slug": "del-twice" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/d2", "slug": "del-twice" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "del-twice" }, "match": "subset" }
        },
        {
          "label": "delete-first",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "del-twice" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/del-twice", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "del-twice", "status": "deleted" }, "match": "subset" }
        },
        {
          "label": "delete-second",
          "request": {
            "v": 1,
            "command": "link.delete",
            "args": { "slug": "del-twice" }
          },
          "rest_resource": { "method": "DELETE", "path": "/api/v1/links/del-twice", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "del-twice", "status": "deleted" }, "match": "subset" }
        }
      ]
    },
    {
      "name": "link_disable_then_preview",
      "doc": "disabling a link flips its status to disabled and preview reflects it",
      "command": "link.disable",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/d3", "slug": "state-disable" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/d3", "slug": "state-disable" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "state-disable", "status": "active" }, "match": "subset" }
        },
        {
          "label": "disable",
          "request": {
            "v": 1,
            "command": "link.disable",
            "args": { "slug": "state-disable" }
          },
          "rest_resource": { "method": "POST", "path": "/api/v1/links/state-disable/disable", "status": 200 },
          "expect": { "ok": true, "result": { "slug": "state-disable", "status": "disabled" }, "match": "subset" }
        },
        {
          "label": "preview",
          "request": {
            "v": 1,
            "command": "link.preview",
            "args": { "slug": "state-disable" }
          },
          "rest_resource": { "method": "GET", "path": "/api/v1/links/state-disable/preview", "status": 200 },
          "expect": {
            "ok": true,
            "result": { "slug": "state-disable", "status": "disabled", "enabled": false },
            "match": "subset"
          }
        }
      ]
    },
    {
      "name": "link_enable_after_disable",
      "doc": "enabling a disabled link returns it to active",
      "command": "link.enable",
      "steps": [
        {
