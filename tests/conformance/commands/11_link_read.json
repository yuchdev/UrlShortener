    {
      "name": "link_stats_range_mode_empty",
      "doc": "stats with from/to/bucket all present returns the empty range report (no analytics served)",
      "command": "link.stats",
      "steps": [
        {
          "label": "seed",
          "request": {
            "v": 1,
            "command": "link.create",
            "args": { "target_url": "https://example.com/sr", "slug": "stats-range" }
          },
          "rest_resource": {
            "method": "POST",
            "path": "/api/v1/links",
            "body": { "target_url": "https://example.com/sr", "slug": "stats-range" },
            "status": 201
          },
          "expect": { "ok": true, "result": { "slug": "stats-range" }, "match": "subset" }
        },
        {
          "label": "stats",
          "request": {
            "v": 1,
            "command": "link.stats",
            "args": { "slug": "stats-range", "from": "100", "to": "200", "bucket": "hour" }
          },
          "rest_resource": {
            "method": "GET",
            "path": "/api/v1/links/stats-range/stats",
            "query": { "from": "100", "to": "200", "bucket": "hour" },
            "status": 200
          },
          "expect": {
            "ok": true,
            "result": {
              "slug": "stats-range",
              "total_attempts": 0,
              "successful_redirects": 0,
              "attempts_by_status_code": {},
              "attempts_by_domain": {},
              "time_buckets": [],
              "from": 100,
              "to": 200,
              "bucket": "hour"
            },
            "match": "exact"
          }
        }
      ]
    },
